{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pgextwin/build/blob/main/schema/issue311-execution-request-v1.schema.json",
  "title": "pgextwin Issue 311 one-shot bounded execution request, declaration only; NOT an authorization credential",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "requestId",
    "mode",
    "requestedBy",
    "createdAt",
    "expiresAt",
    "purpose",
    "allowFutureUpdates",
    "source",
    "limits",
    "approval",
    "targets",
    "resumeFrom"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "pgextwin-execution-request"
    },
    "requestId": {
      "type": "string",
      "pattern": "^r-[0-9]{8}-[a-z0-9-]{8,56}$",
      "maxLength": 72
    },
    "mode": {
      "enum": [
        "AUDIT_ONLY",
        "PREPARE",
        "PUBLISH_ELIGIBLE"
      ]
    },
    "requestedBy": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$",
      "description": "Informational only; NEVER used as proof of real GitHub actor"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "allowFutureUpdates": {
      "const": false
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "centralMainSha",
        "fleetRegistryBlobSha"
      ],
      "properties": {
        "centralMainSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "fleetRegistryBlobSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxParallel",
        "maxAttemptsPerStage",
        "maxOperations",
        "maxWallClockMinutes"
      ],
      "properties": {
        "maxParallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "maxAttemptsPerStage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "maxOperations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "maxWallClockMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeText",
        "publicReleaseAuthorized",
        "publicationGrants"
      ],
      "properties": {
        "scopeText": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "publicReleaseAuthorized": {
          "type": "boolean"
        },
        "publicationGrants": {
          "type": "array",
          "minItems": 0,
          "maxItems": 17,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "releaseTag",
              "candidateHeadSha",
              "candidateRunId",
              "decisionRunId",
              "packagingMainSha"
            ],
            "properties": {
              "repo": {
                "enum": [
                  "pgextwin/pg_bigm",
                  "pgextwin/pg_cron",
                  "pgextwin/pg_hint_plan",
                  "pgextwin/pgaudit",
                  "pgextwin/set_user",
                  "pgextwin/pg_repack",
                  "pgextwin/pg_ivm",
                  "pgextwin/pg_qualstats",
                  "pgextwin/plpgsql_check",
                  "pgextwin/orafce",
                  "pgextwin/hypopg",
                  "pgextwin/wal2json",
                  "pgextwin/pg_partman",
                  "pgextwin/pg_stat_monitor",
                  "pgextwin/pgtap",
                  "pgextwin/pg_variables",
                  "pgextwin/pg_store_plans"
                ]
              },
              "releaseTag": {
                "type": "string",
                "pattern": "^v[A-Za-z0-9][A-Za-z0-9._-]{0,110}-windows\\.[1-9][0-9]*$"
              },
              "candidateHeadSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "candidateRunId": {
                "type": "integer",
                "minimum": 1
              },
              "decisionRunId": {
                "type": "integer",
                "minimum": 1
              },
              "packagingMainSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "mainSha"
        ],
        "properties": {
          "repo": {
            "enum": [
              "pgextwin/pg_bigm",
              "pgextwin/pg_cron",
              "pgextwin/pg_hint_plan",
              "pgextwin/pgaudit",
              "pgextwin/set_user",
              "pgextwin/pg_repack",
              "pgextwin/pg_ivm",
              "pgextwin/pg_qualstats",
              "pgextwin/plpgsql_check",
              "pgextwin/orafce",
              "pgextwin/hypopg",
              "pgextwin/wal2json",
              "pgextwin/pg_partman",
              "pgextwin/pg_stat_monitor",
              "pgextwin/pgtap",
              "pgextwin/pg_variables",
              "pgextwin/pg_store_plans"
            ]
          },
          "mainSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "resumeFrom": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^r-[0-9]{8}-[a-z0-9-]{8,56}$",
          "maxLength": 72
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "AUDIT_ONLY",
              "PREPARE"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "publicReleaseAuthorized": {
                "const": false
              },
              "publicationGrants": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "PUBLISH_ELIGIBLE"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "publicReleaseAuthorized": {
                "const": true
              },
              "publicationGrants": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
