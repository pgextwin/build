{
  "$defs": {
    "buildLicenseFile": {
      "additionalProperties": false,
      "properties": {
        "generatedPath": {
          "minLength": 1,
          "type": "string"
        },
        "generatedSource": {
          "enum": [
            "upstream",
            "buildOutput"
          ]
        },
        "origin": {
          "const": "build"
        },
        "repositoryPath": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "repositoryPath",
        "generatedSource",
        "generatedPath",
        "sha256"
      ],
      "type": "object"
    },
    "licenseBlock": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "files"
                ]
              },
              {
                "required": [
                  "perPostgresql"
                ]
              }
            ]
          },
          "required": [
            "upstreamPath"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "upstreamPath"
                ]
              },
              {
                "required": [
                  "perPostgresql"
                ]
              }
            ]
          },
          "required": [
            "files"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "upstreamPath"
                ]
              },
              {
                "required": [
                  "files"
                ]
              }
            ]
          },
          "required": [
            "perPostgresql"
          ]
        }
      ],
      "properties": {
        "files": {
          "$ref": "#/$defs/licenseFileList"
        },
        "perPostgresql": {
          "additionalProperties": {
            "$ref": "#/$defs/licenseFileList"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "type": "object"
        },
        "upstreamPath": {
          "minLength": 1,
          "type": "string"
        },
        "verifyAgainstUpstream": {
          "const": true
        }
      },
      "required": [
        "verifyAgainstUpstream"
      ],
      "type": "object"
    },
    "licenseFileList": {
      "contains": {
        "$ref": "#/$defs/upstreamLicenseFile"
      },
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/upstreamLicenseFile"
          },
          {
            "$ref": "#/$defs/packagingLicenseFile"
          },
          {
            "$ref": "#/$defs/buildLicenseFile"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "packageFile": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "minLength": 1,
          "type": "string"
        },
        "expectedCount": {
          "minimum": 1,
          "type": "integer"
        },
        "optional": {
          "type": "boolean"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "requiredMatches": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "source": {
          "enum": [
            "upstream",
            "license",
            "buildOutput",
            "packaging",
            "licenseDocument"
          ]
        },
        "targets": {
          "items": {
            "enum": [
              "install",
              "zip"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "source",
        "path",
        "destination",
        "targets"
      ],
      "type": "object"
    },
    "packagingLicenseFile": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "const": "packaging"
        },
        "repositoryPath": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "repositoryPath",
        "sha256"
      ],
      "type": "object"
    },
    "perMajorPackaging": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/packageFile"
          },
          "minItems": 1,
          "type": "array"
        },
        "sqlExtensionName": {
          "minLength": 1,
          "type": "string"
        },
        "sqlInstallPath": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "type": "array"
        },
        "sqlVersion": {
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "upstreamBlock": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "required": [
              "perPostgresql"
            ]
          },
          "required": [
            "ref",
            "version",
            "commit"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "version"
                ]
              },
              {
                "required": [
                  "commit"
                ]
              }
            ]
          },
          "required": [
            "perPostgresql"
          ]
        }
      ],
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "perPostgresql": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "commit": {
                "pattern": "^[0-9a-f]{40}$",
                "type": "string"
              },
              "ref": {
                "minLength": 1,
                "type": "string"
              },
              "version": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "ref",
              "version",
              "commit"
            ],
            "type": "object"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "type": "object"
        },
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "repository": {
          "pattern": "^[^/]+/[^/]+$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repository"
      ],
      "type": "object"
    },
    "upstreamLicenseFile": {
      "additionalProperties": false,
      "properties": {
        "repositoryPath": {
          "minLength": 1,
          "type": "string"
        },
        "upstreamPath": {
          "minLength": 1,
          "type": "string"
        },
        "upstreamStartMarker": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repositoryPath",
        "upstreamPath"
      ],
      "type": "object"
    }
  },
  "$id": "https://pgextwin.github.io/schema/central-extension.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Central declaration for one extension in the pgextwin/build monorepo. Merges the legacy per-repository config/extension.json (7 keys) and windows/ci/package.json layers, adds the adapter designation and declared build options, and normalizes postgresql.majors to the array form. The upstream block remains the single source of truth for source pinning; no source-lock.json is created.",
  "properties": {
    "adapter": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "adapter.ps1"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "build": {
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "enum": [
            "sql-only",
            "dll-only",
            "dll-sql"
          ]
        },
        "options": {
          "additionalProperties": false,
          "properties": {
            "components": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "defines": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "dependencies": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "exports": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "type": "object"
        }
      },
      "required": [
        "distribution"
      ],
      "type": "object"
    },
    "license": {
      "$ref": "#/$defs/licenseBlock"
    },
    "name": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
      "type": "string"
    },
    "packaging": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/packageFile"
          },
          "minItems": 1,
          "type": "array"
        },
        "packageInfo": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "packageInfoFinalNewline": {
          "type": "boolean"
        },
        "perPostgresql": {
          "additionalProperties": {
            "$ref": "#/$defs/perMajorPackaging"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "type": "object"
        },
        "sqlExtensionName": {
          "minLength": 1,
          "type": "string"
        },
        "sqlInstallPath": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "type": "array"
        },
        "sqlVersion": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "files",
        "packageInfo"
      ],
      "type": "object"
    },
    "postgresql": {
      "additionalProperties": false,
      "properties": {
        "majors": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "majors"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1
    },
    "tests": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "tests/test-contract.json"
        },
        "smokeTest": {
          "const": "tests/smoke-test.ps1"
        }
      },
      "type": "object"
    },
    "upstream": {
      "$ref": "#/$defs/upstreamBlock"
    },
    "watch": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "perPostgresql"
              ]
            },
            "required": [
              "stableTagPattern"
            ]
          },
          "if": {
            "properties": {
              "strategy": {
                "const": "github-releases-per-postgresql"
              }
            },
            "required": [
              "strategy"
            ]
          },
          "then": {
            "not": {
              "required": [
                "stableTagPattern"
              ]
            },
            "required": [
              "perPostgresql"
            ]
          }
        }
      ],
      "properties": {
        "perPostgresql": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "informational": {
                "type": "boolean"
              },
              "tagPattern": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "tagPattern"
            ],
            "type": "object"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "type": "object"
        },
        "prereleases": {
          "const": false,
          "type": "boolean"
        },
        "source": {
          "const": "github"
        },
        "stableTagPattern": {
          "minLength": 1,
          "type": "string"
        },
        "strategy": {
          "enum": [
            "github-releases",
            "github-tags",
            "github-releases-per-postgresql"
          ]
        }
      },
      "required": [
        "source",
        "strategy",
        "prereleases"
      ],
      "type": "object"
    },
    "windows": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "const": "x64"
        }
      },
      "required": [
        "architecture"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "upstream",
    "postgresql",
    "windows",
    "build",
    "packaging",
    "license"
  ],
  "title": "pgextwin central monorepo extension declaration (extensions/<name>/extension.json)",
  "type": "object"
}
