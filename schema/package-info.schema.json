{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pgextwin PACKAGE-INFO.json",
  "description": "Machine-readable source and build metadata embedded in pgextwin Windows packages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "buildMode",
    "package",
    "upstream",
    "source",
    "buildInfrastructure",
    "postgresql",
    "toolchain",
    "workflowRun",
    "runner"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "buildMode": {
      "type": "string",
      "enum": [
        "normal",
        "release-attested"
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "platform",
        "architecture"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "platform": {
          "const": "windows"
        },
        "architecture": {
          "const": "x64"
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "version",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packagingRepository",
        "packagingCommit"
      ],
      "properties": {
        "packagingRepository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "packagingCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "buildInfrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "workflow"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflow": {
          "type": "string",
          "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "testedVersion",
        "installation"
      ],
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 10,
          "maximum": 99
        },
        "testedVersion": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
        },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packageManager",
            "package",
            "packageVersion"
          ],
          "properties": {
            "packageManager": {
              "const": "chocolatey"
            },
            "package": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.+-]+$"
            },
            "packageVersion": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]*$"
            }
          }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "compilerVersion"
      ],
      "properties": {
        "compiler": {
          "const": "MSVC"
        },
        "compilerVersion": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+(?:\\.[0-9]+){2,4}$"
        }
      }
    },
    "workflowRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "attempt",
        "url",
        "event",
        "ref"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+/.+/actions/runs/[0-9]+$"
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/",
          "maxLength": 512
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "requestedLabel",
        "imageOS",
        "imageVersion"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "requestedLabel": {
          "const": "windows-latest"
        },
        "imageOS": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "imageVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    }
  }
}
