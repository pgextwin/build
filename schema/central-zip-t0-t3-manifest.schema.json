{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Central Publisher ZIP T0–T3 manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "extension",
    "signingRunId",
    "signingRunAttempt",
    "protectedMainSha",
    "od01Tag",
    "stageStatus",
    "expectedTargetCount",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "extension": {
      "$ref": "#/$defs/extension"
    },
    "signingRunId": {
      "$ref": "#/$defs/positive"
    },
    "signingRunAttempt": {
      "$ref": "#/$defs/positive"
    },
    "protectedMainSha": {
      "$ref": "#/$defs/sha40"
    },
    "od01Tag": {
      "$ref": "#/$defs/tag"
    },
    "stageStatus": {
      "enum": [
        "RELEASE_PUBLISHED_AWAITING_CLI_RECEIPT",
        "COMPLETE_T0_T3"
      ]
    },
    "expectedTargetCount": {
      "$ref": "#/$defs/positive"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": {
      "stageStatus": {
        "const": "COMPLETE_T0_T3"
      }
    }
  },
  "then": {
    "properties": {
      "entries": {
        "items": {
          "properties": {
            "cliReceipt": {
              "$ref": "#/$defs/cliReceipt"
            }
          }
        }
      }
    }
  },
  "else": {
    "properties": {
      "entries": {
        "items": {
          "properties": {
            "cliReceipt": {
              "type": "null"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "positive": {
      "type": "integer",
      "minimum": 1
    },
    "extension": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "zipName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*\\.zip$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}/v[0-9]+(?:\\.[0-9]+){1,3}(?:-[0-9]{8})?-windows\\.[1-9][0-9]*$"
    },
    "sha40": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entry": {
      "type": "object",
      "required": [
        "extension",
        "pgMajor",
        "fileName",
        "sha256",
        "size",
        "handoffs",
        "release",
        "cliReceipt"
      ],
      "properties": {
        "extension": {
          "$ref": "#/$defs/extension"
        },
        "pgMajor": {
          "$ref": "#/$defs/positive"
        },
        "fileName": {
          "$ref": "#/$defs/zipName"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/positive"
        },
        "handoffs": {
          "type": "object",
          "required": [
            "T0",
            "T1",
            "T2"
          ],
          "properties": {
            "T0": {
              "$ref": "#/$defs/T0"
            },
            "T1": {
              "$ref": "#/$defs/T1"
            },
            "T2": {
              "$ref": "#/$defs/T2"
            }
          },
          "additionalProperties": false
        },
        "release": {
          "type": "object",
          "required": [
            "tag",
            "releaseId",
            "releaseUrl",
            "assetId",
            "assetName",
            "assetSha256",
            "assetSize",
            "publishedAt"
          ],
          "properties": {
            "tag": {
              "$ref": "#/$defs/tag"
            },
            "releaseId": {
              "$ref": "#/$defs/positive"
            },
            "releaseUrl": {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            },
            "assetId": {
              "$ref": "#/$defs/positive"
            },
            "assetName": {
              "$ref": "#/$defs/zipName"
            },
            "assetSha256": {
              "$ref": "#/$defs/sha256"
            },
            "assetSize": {
              "$ref": "#/$defs/positive"
            },
            "publishedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "additionalProperties": false
        },
        "cliReceipt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/cliReceipt"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "cliReceipt": {
      "type": "object",
      "required": [
        "catalogCommit",
        "source",
        "verificationLevel",
        "signatureVerified",
        "provenanceVerified",
        "publicationAuthorized",
        "distributionAuthorized",
        "installAuthorized",
        "relativePath",
        "bytes",
        "sha256",
        "zipCount"
      ],
      "properties": {
        "catalogCommit": {
          "$ref": "#/$defs/sha40"
        },
        "source": {
          "const": "SIGSTORE_SIGNED_CATALOG_FEED_ORIGINAL_ZIPS"
        },
        "verificationLevel": {
          "const": "INTEGRITY_ONLY"
        },
        "signatureVerified": {
          "const": false
        },
        "provenanceVerified": {
          "const": false
        },
        "publicationAuthorized": {
          "const": false
        },
        "distributionAuthorized": {
          "const": false
        },
        "installAuthorized": {
          "const": false
        },
        "relativePath": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.zip$"
        },
        "bytes": {
          "$ref": "#/$defs/positive"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "zipCount": {
          "$ref": "#/$defs/positive"
        }
      },
      "additionalProperties": false
    },
    "T0": {
      "type": "object",
      "required": [
        "schemaVersion",
        "stage",
        "extension",
        "pgMajor",
        "fileName",
        "sha256",
        "size",
        "previousStage",
        "previousSha256"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "stage": {
          "const": "T0"
        },
        "extension": {
          "$ref": "#/$defs/extension"
        },
        "pgMajor": {
          "$ref": "#/$defs/positive"
        },
        "fileName": {
          "$ref": "#/$defs/zipName"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/positive"
        },
        "previousStage": {
          "type": "null"
        },
        "previousSha256": {
          "type": "null"
        }
      },
      "additionalProperties": false
    },
    "T1": {
      "type": "object",
      "required": [
        "schemaVersion",
        "stage",
        "extension",
        "pgMajor",
        "fileName",
        "sha256",
        "size",
        "previousStage",
        "previousSha256"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "stage": {
          "const": "T1"
        },
        "extension": {
          "$ref": "#/$defs/extension"
        },
        "pgMajor": {
          "$ref": "#/$defs/positive"
        },
        "fileName": {
          "$ref": "#/$defs/zipName"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/positive"
        },
        "previousStage": {
          "const": "T0"
        },
        "previousSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "T2": {
      "type": "object",
      "required": [
        "schemaVersion",
        "stage",
        "extension",
        "pgMajor",
        "fileName",
        "sha256",
        "size",
        "previousStage",
        "previousSha256"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "stage": {
          "const": "T2"
        },
        "extension": {
          "$ref": "#/$defs/extension"
        },
        "pgMajor": {
          "$ref": "#/$defs/positive"
        },
        "fileName": {
          "$ref": "#/$defs/zipName"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/positive"
        },
        "previousStage": {
          "const": "T1"
        },
        "previousSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
