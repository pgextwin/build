{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgextwin.github.io/schema/update-watch.schema.json",
  "title": "pgextwin upstream update watch contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "repository", "strategy", "prereleases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "const": "github" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "strategy": {"enum": ["github-releases", "github-tags", "github-releases-per-postgresql"]},
    "prereleases": { "type": "boolean", "const": false },
    "stableTagPattern": {"type": "string", "minLength": 1, "maxLength": 256},
    "perPostgresql": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9]{2}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tagPattern"],
          "properties": {
            "tagPattern": {"type": "string", "minLength": 1, "maxLength": 256},
            "informational": {"type": "boolean", "default": false}
          }
        }
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"strategy": {"const": "github-releases-per-postgresql"}}},
    "then": {"required": ["perPostgresql"], "not": {"required": ["stableTagPattern"]}},
    "else": {"required": ["stableTagPattern"], "not": {"required": ["perPostgresql"]}}
  }]
}
