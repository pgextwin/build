{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pgextwin/build/blob/main/schema/local-candidate-authority.schema.json",
  "title": "pgextwin local candidate authority",
  "description": "Central candidate authority with a finite ENFORCE delegation and a mode-only DENY switch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "policyEpoch",
    "issuerKeyId",
    "issuerPublicKey",
    "note",
    "revokedPolicyEpochs",
    "delegationStartsAt",
    "delegationEndsAt",
    "targetSet",
    "allowedOperations",
    "publication",
    "boundaries",
    "rateLimits"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "mode": {
      "enum": ["DENY", "ENFORCE"]
    },
    "policyEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issuerKeyId": {
      "const": "local-auth-prod-1"
    },
    "issuerPublicKey": {
      "const": "d8aaf19ea48e7ef9ca82dea860a04b5eafad92ff82378b5cd73d2f137b3a727c"
    },
    "note": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    },
    "revokedPolicyEpochs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "delegationStartsAt": {
      "type": ["null", "string"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "delegationEndsAt": {
      "type": ["null", "string"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "targetSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schemaVersion"
      ],
      "properties": {
        "path": {
          "const": "metadata/automation-fleet.json"
        },
        "schemaVersion": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "allowedOperations": {
      "const": [
        "candidate",
        "requalify"
      ]
    },
    "publication": {
      "const": false
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateManualOnlyInferred",
        "releaseOptInInferred",
        "environmentInferred",
        "admissionInferred",
        "note"
      ],
      "properties": {
        "candidateManualOnlyInferred": {
          "const": false
        },
        "releaseOptInInferred": {
          "const": false
        },
        "environmentInferred": {
          "const": false
        },
        "admissionInferred": {
          "const": false
        },
        "note": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        }
      }
    },
    "rateLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxUnresolvedCandidatesPerRepository",
        "candidateAuthorizationsPerRepositoryPer15Minutes",
        "candidateAuthorizationsPerRepositoryPerHour"
      ],
      "properties": {
        "maxUnresolvedCandidatesPerRepository": {
          "type": "integer",
          "const": 1
        },
        "candidateAuthorizationsPerRepositoryPer15Minutes": {
          "type": "integer",
          "const": 1
        },
        "candidateAuthorizationsPerRepositoryPerHour": {
          "type": "integer",
          "const": 4
        }
      }
    }
  },
  "if": {"properties": {"mode": {"const": "ENFORCE"}}},
  "then": {
    "properties": {
      "delegationStartsAt": {"type": "string"},
      "delegationEndsAt": {"type": "string"}
    }
  }
}
