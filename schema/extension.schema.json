{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgextwin.github.io/schema/extension.schema.json",
  "title": "pgextwin extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "upstream",
    "postgresql",
    "windows",
    "license"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "perPostgresql": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "version"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "ref",
            "version"
          ],
          "not": {
            "required": [
              "perPostgresql"
            ]
          }
        },
        {
          "required": [
            "perPostgresql"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "version"
                ]
              }
            ]
          }
        }
      ]
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minMajor": {
          "type": "integer",
          "minimum": 1
        },
        "maxMajor": {
          "type": "integer",
          "minimum": 1
        },
        "majors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "minMajor",
            "maxMajor"
          ],
          "not": {
            "required": [
              "majors"
            ]
          }
        },
        {
          "required": [
            "majors"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "minMajor"
                ]
              },
              {
                "required": [
                  "maxMajor"
                ]
              }
            ]
          }
        }
      ]
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture"
      ],
      "properties": {
        "architecture": {
          "const": "x64"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifyAgainstUpstream"
      ],
      "properties": {
        "verifyAgainstUpstream": {
          "type": "boolean"
        },
        "upstreamPath": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repositoryPath",
              "upstreamPath"
            ],
            "properties": {
              "repositoryPath": {
                "type": "string",
                "minLength": 1
              },
              "upstreamPath": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "perPostgresql": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repositoryPath",
                "upstreamPath"
              ],
              "properties": {
                "repositoryPath": {
                  "type": "string",
                  "minLength": 1
                },
                "upstreamPath": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "upstreamPath"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "files"
                ]
              },
              {
                "required": [
                  "perPostgresql"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "files"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "upstreamPath"
                ]
              },
              {
                "required": [
                  "perPostgresql"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "perPostgresql"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "upstreamPath"
                ]
              },
              {
                "required": [
                  "files"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
