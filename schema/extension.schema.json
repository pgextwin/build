{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgextwin.github.io/schema/extension.schema.json",
  "title": "pgextwin extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "upstream",
    "postgresql",
    "windows",
    "license"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "version"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minMajor": {
          "type": "integer",
          "minimum": 1
        },
        "maxMajor": {
          "type": "integer",
          "minimum": 1
        },
        "majors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "minMajor",
            "maxMajor"
          ],
          "not": {
            "required": [
              "majors"
            ]
          }
        },
        {
          "required": [
            "majors"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "minMajor"
                ]
              },
              {
                "required": [
                  "maxMajor"
                ]
              }
            ]
          }
        }
      ]
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture"
      ],
      "properties": {
        "architecture": {
          "const": "x64"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifyAgainstUpstream",
        "upstreamPath"
      ],
      "properties": {
        "verifyAgainstUpstream": {
          "type": "boolean"
        },
        "upstreamPath": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
