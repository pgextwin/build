{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgextwin.github.io/schema/extension.schema.json",
  "title": "pgextwin extension manifest",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "upstreamLicenseFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryPath",
        "upstreamPath"
      ],
      "properties": {
        "repositoryPath": {
          "type": "string",
          "minLength": 1
        },
        "upstreamPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packagingLicenseFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "repositoryPath",
        "sha256"
      ],
      "properties": {
        "origin": {
          "const": "packaging"
        },
        "repositoryPath": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "buildLicenseFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "repositoryPath",
        "generatedSource",
        "generatedPath",
        "sha256"
      ],
      "properties": {
        "origin": {
          "const": "build"
        },
        "repositoryPath": {
          "type": "string",
          "minLength": 1
        },
        "generatedSource": {
          "enum": [
            "upstream",
            "buildOutput"
          ]
        },
        "generatedPath": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "licenseFileList": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "$ref": "#/$defs/upstreamLicenseFile"
      },
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/upstreamLicenseFile"
          },
          {
            "$ref": "#/$defs/packagingLicenseFile"
          },
          {
            "$ref": "#/$defs/buildLicenseFile"
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "upstream",
    "postgresql",
    "windows",
    "license"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "perPostgresql": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "version"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              }
            }
          }
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      },
      "oneOf": [
        {
          "required": [
            "ref",
            "version"
          ],
          "not": {
            "required": [
              "perPostgresql"
            ]
          }
        },
        {
          "required": [
            "perPostgresql"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "version"
                ]
              }
            ]
          }
        }
      ]
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minMajor": {
          "type": "integer",
          "minimum": 1
        },
        "maxMajor": {
          "type": "integer",
          "minimum": 1
        },
        "majors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "minMajor",
            "maxMajor"
          ],
          "not": {
            "required": [
              "majors"
            ]
          }
        },
        {
          "required": [
            "majors"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "minMajor"
                ]
              },
              {
                "required": [
                  "maxMajor"
                ]
              }
            ]
          }
        }
      ]
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture"
      ],
      "properties": {
        "architecture": {
          "const": "x64"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifyAgainstUpstream"
      ],
      "properties": {
        "verifyAgainstUpstream": {
          "type": "boolean"
        },
        "upstreamPath": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "$ref": "#/$defs/licenseFileList"
        },
        "perPostgresql": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/licenseFileList"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "upstreamPath"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "files"
                ]
              },
              {
                "required": [
                  "perPostgresql"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "files"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "upstreamPath"
                ]
              },
              {
                "required": [
                  "perPostgresql"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "perPostgresql"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "upstreamPath"
                ]
              },
              {
                "required": [
                  "files"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
