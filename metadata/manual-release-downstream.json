{
  "schemaVersion": 1,
  "enabled": true,
  "mode": "POST_VERIFIED_RELEASE_ONLY",
  "releasePolicy": "automatic-signed-schedule",
  "automaticFormalRelease": true,
  "automaticCatalogMerge": true,
  "allowedExtensions": [
    "hypopg",
    "orafce",
    "pg_bigm",
    "pg_cron",
    "pg_hint_plan",
    "pg_ivm",
    "pg_partman",
    "pg_qualstats",
    "pg_repack",
    "pg_stat_monitor",
    "pg_store_plans",
    "pg_variables",
    "pgaudit",
    "pgtap",
    "plpgsql_check",
    "set_user",
    "wal2json"
  ],
  "requiredCatalogWorkflow": "validate.yml",
  "requirePublishedPublicRelease": true,
  "requireBuildProvenanceAttestation": true,
  "requireSbomAttestation": true,
  "requireExactSHA256": true,
  "requireExactHeadRequiredChecks": true,
  "requireDedicatedMergeApp": true,
  "denyUnknownOrDuplicate": true,
  "notes": "Explicit downstream declaration only; Catalog local/App opt-ins, public signed Release verification and exact-head protected PR checks remain mandatory."
}
