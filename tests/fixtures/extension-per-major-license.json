{
  "schemaVersion": 1,
  "name": "fixture-per-major-license",
  "upstream": {
    "repository": "example/fixture",
    "perPostgresql": {
      "14": { "ref": "REL14", "version": "14.1" },
      "16": { "ref": "REL16", "version": "16.1" }
    }
  },
  "postgresql": {
    "majors": [14, 16]
  },
  "windows": {
