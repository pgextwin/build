        },
        {
          "repositoryPath": "licenses/pg14/COPYRIGHT.postgresql",
          "upstreamPath": "COPYRIGHT.postgresql"
        }
      ],
      "16": [
        {
          "repositoryPath": "licenses/pg16/COPYRIGHT",
          "upstreamPath": "COPYRIGHT"
        },
        {
          "repositoryPath": "licenses/pg16/COPYRIGHT.postgresql",
          "upstreamPath": "COPYRIGHT.postgresql"
        }
      ]
    }
  }
}
